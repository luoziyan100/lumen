{
  "name": "@lumen/mastra-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts tests/lifecycle/*.test.ts tests/migration/*.test.ts tests/execution/*.test.ts tests/deployment/*.test.ts tests/agents/*.test.ts tests/catalog/*.test.ts tests/agents/usage/*.test.ts tests/agents/lifecycle/*.test.ts",
    "start": "node --experimental-strip-types src/start.ts",
    "launchd:install": "node --experimental-strip-types scripts/launchd-cli.ts install",
    "launchd:status": "node --experimental-strip-types scripts/launchd-cli.ts status",
    "launchd:uninstall": "node --experimental-strip-types scripts/launchd-cli.ts uninstall",
    "import:legacy": "node --experimental-strip-types scripts/import-legacy.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.103",
    "@ai-sdk/openai-compatible": "2.0.62",
    "@hono/node-server": "2.1.1",
    "@mastra/client-js": "1.46.0",
    "@mastra/core": "1.67.0",
    "@mastra/hono": "1.7.9",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "hono": "4.13.8",
    "saxes": "6.0.0",
    "unpdf": "1.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "~5.9.0"
  }
}
