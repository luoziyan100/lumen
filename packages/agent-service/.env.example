# 复制为 .env 并填入你的值;service 启动时自动读取(.env 不进 git)。
# 已在 shell 里设过的同名环境变量优先,.env 不会覆盖它。

LUMEN_PORT=8787
LUMEN_PROVIDER=openai
LUMEN_API_KEY=
LUMEN_BASE_URL=
TAVILY_API_KEY=
# LUMEN_MODEL=claude-opus-4-8

# 识图(硅基流动等 VL;主模型 DeepSeek 不吃 image_url 时用 look_at_image)
# 注意:Qwen/Qwen-Image 是文生图,不能识图。请用 Qwen3-VL-*（硅基上 2.5-VL 可能已下架）。
LUMEN_VISION_API_KEY=
# 注意:不要带尾部 /v1(transport 会再拼 /v1/chat/completions)
LUMEN_VISION_BASE_URL=https://api.siliconflow.cn
LUMEN_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# LUMEN_VISION_FORCE=1  # 强制主模型去图插桩(非 DeepSeek 也可)
